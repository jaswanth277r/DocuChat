# DocuChat configuration — copy to .env and adjust.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=change-me-to-a-random-48-byte-token
ENVIRONMENT=development
COOKIE_SECURE=false
SERVE_FRONTEND=true

# Database and queue
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=docuchat
REDIS_URL=redis://127.0.0.1:6379/0

# Storage (defaults are relative to the repository)
# For a small system partition, point DATA_DIR and EMBED_CACHE_DIR at a larger
# volume, or use .env.local with the helper scripts.
DATA_DIR=./data
EMBED_CACHE_DIR=./data/models

MAX_UPLOAD_MB=25
MAX_PAGES=500
RETENTION_DAYS=30
UPLOADS_PER_HOUR=10
CHATS_PER_HOUR=120

# Embeddings: fastembed (local neural), hashing (offline fallback), openai
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=32

# Generation: extractive (grounded, no key), openai (OpenAI/Groq-compatible), ollama
LLM_PROVIDER=extractive
# Groq example:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=...
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434
#   LLM_MODEL=qwen2.5:3b-instruct
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_S=90

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
ENABLE_RERANK=true
ENABLE_SUPPORT_VERIFICATION=true
MIN_RETRIEVAL_CONFIDENCE=0.22
MAX_CONTEXT_TOKENS=5000
